#
# Samsung Electronics TOUCH driver configuration
#

config SAMSUNG_PRODUCT_SHIP
        bool "Samsung shipping product build"
        default n
        help
          Set for retail firmware: leaves out the sec_ts raw device sysfs
          nodes and the vendor-only debug code.

config TOUCHSCREEN_SEC_TS
        tristate "Samsung Electronics Touchscreen"
        depends on I2C
        select TOUCHSCREEN_SEC_CMD_HELPERS
        help
          Say Y here if you want support for SEC touchscreen controllers.
          If unsure, say N.

          To compile this driver as a module, choose M here: the
          module will be called sec_ts.

config TOUCHSCREEN_SEC_TS_ALLOW_FW_WRITE
	bool "Allow sec_ts chip flash/NVM/calibration writes"
	depends on TOUCHSCREEN_SEC_TS
	default n
	help
	  Firmware/bootloader flashing (probe, sysfs fw_update, UMS/FFU),
	  NVM writes (set nvm, TCLM) and force calibration are refused with
	  -EPERM unless this is set. Off by default: an interrupted write
	  can brick the controller. Reads are not affected.

config TOUCHSCREEN_SEC_TS_GLOVEMODE
        tristate "Samsung Electronics Touchscreen"
        depends on I2C
        help
          Say Y here if you have a Samsung Electronics Touchscreen and want to enable
          support for the built-in touchscreen.

          If unsure, say N.
