// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy A8 Star (SM-G885S, codename astarqlte, SoC SDM660).
 * Phase 1: boot essentials, volume/bixby keys, touch power and touch IC.
 */

/dts-v1/;

#include "sdm660.dtsi"
#include "sdm660-mtp.dtsi"
#include "sdm660-external-codec.dtsi"
#include "dsi-panel-s6e3fa7-ams628rf01-fhd-cmd.dtsi"

/ {
	model = "Samsung A-STARQLTE KOR PROJECT Rev06 (board-id,07)";
	compatible = "qcom,sdm660-mtp", "qcom,sdm660", "qcom,mtp";
	qcom,msm-id = <0x13d 0x0>;
	qcom,board-id = <0x8 0x7>;

	reserved-memory {
		/* base sdm660.dtsi ramoops (0x9ff00000) replaced by stock layout */
		/delete-node/ ramoops;

		ramoops@84d00000 {
			compatible = "ramoops";
			reg = <0x0 0x84d00000 0x0 0x100000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			ftrace-size = <0x40000>;
			pmsg-size = <0x40000>;
		};
	};
};

&tlmm {
	/*
	 * PCAL6524 expander reset line. Held high (out of reset) from boot,
	 * the same as the stock expander_reset_active pinctrl state.
	 */
	pcal6524_reset {
		gpio-hog;
		gpios = <33 0>;
		output-high;
		line-name = "pcal6524-reset";
	};

	i2c_23_pinctrl: i2c_23_pinctrl {
		mux {
			pins = "gpio52", "gpio51";
			function = "gpio";
		};

		config {
			pins = "gpio52", "gpio51";
			drive-strength = <2>;
			bias-disable;
		};
	};

	tsp_int {
		tsp_int_active: tsp_int_active {
			mux {
				pins = "gpio67";
				function = "gpio";
			};

			config {
				pins = "gpio67";
				drive-strength = <2>;
				bias-disable;
				input-enable;
			};
		};

		tsp_int_suspend: tsp_int_suspend {
			mux {
				pins = "gpio67";
				function = "gpio";
			};

			config {
				pins = "gpio67";
				drive-strength = <2>;
				bias-disable;
				input-enable;
			};
		};
	};
};

&soc {
	/*
	 * Stock i2c@23 (i2c-gpio, SDA = gpio52, SCL = gpio51). The PCAL6524
	 * expander and everything behind it hangs off this bus.
	 */
	i2c-gpio-23 {
		compatible = "i2c-gpio";
		gpios = <&tlmm 52 0 &tlmm 51 0>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_23_pinctrl>;

		pcal6524: gpio-expander@22 {
			compatible = "nxp,pcal6524";
			reg = <0x22>;
			gpio-controller;
			#gpio-cells = <2>;
		};
	};

	/* Motor enable is expander pin 1 (stock msm_vibrator motor-en). */
	gpio_vibrator {
		compatible = "gpio-vibrator";
		motor-en = <&pcal6524 1 0x0>;
	};

	tsp_ldo_en {
		compatible = "regulator-fixed";
		regulator-name = "tsp_ldo_en";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <&pm660l_gpios 4 0x0>;
		enable-active-high;
		regulator-boot-on;
	};

	gpio_keys {
		/delete-property/ pinctrl-1;
		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default>;

		/delete-node/ camera_focus;
		/delete-node/ camera_snapshot;

		key_wink {
			label = "key_wink";
			gpios = <&pm660l_gpios 8 0x1>;
			linux,input-type = <1>;
			linux,code = <0x2bf>;
			gpio-key,wakeup;
			debounce-interval = <15>;
		};
	};
};

&mdss_dsi {
	hw-config = "single_dsi";
};

&mdss_dsi0 {
	qcom,dsi-pref-prim-pan = <&dsi_s6e3fa7_ams628rf01_fhd_cmd>;
	pinctrl-names = "mdss_default", "mdss_sleep";
	pinctrl-0 = <&mdss_dsi_active &mdss_te_active>;
	pinctrl-1 = <&mdss_dsi_suspend &mdss_te_suspend>;
	qcom,platform-reset-gpio = <&tlmm 53 0>;
	qcom,platform-te-gpio = <&tlmm 59 0>;
	wqhd-vddio-supply = <&pm660_l11>;
	vdda-3p3-supply = <&pm660l_l6>;
};

&mdss_dsi1 {
	status = "disabled";
};

&i2c_4 {
	status = "okay";

	touchscreen@20 {
		status = "okay";
		compatible = "zinitix,bt532_ts_device";
		reg = <0x20>;
		pinctrl-names = "on_state", "off_state";
		pinctrl-0 = <&tsp_int_active>;
		pinctrl-1 = <&tsp_int_suspend>;
		zinitix,irq_gpio = <&tlmm 67 0x0>;
		zinitix,gpio_ldo_en;
		zinitix,regulator_avdd = "tsp_ldo_en";
		zinitix,x_resolution = <0x438>;
		zinitix,y_resolution = <0x8ac>;
		zinitix,page_size = <0x80>;
		zinitix,chip_name = "ZT7548";
		zinitix,firmware_name = "tsp_zinitix/zt7548_astar.fw";
		zinitix,spay = "true";
		zinitix,aod = "true";
		zinitix,tclm_level = <0x2>;
		zinitix,afe_base = <0x800a>;
		zinitix,mis_cal_check = "true";
		clock-names = "iface_clk", "core_clk";
		clocks = <&clock_gcc GCC_BLSP1_AHB_CLK>,
			 <&clock_gcc GCC_BLSP1_QUP4_I2C_APPS_CLK>;
		zinitix,factory_item_version = <0x4>;
	};
};

&i2c_6 {
	/* The MTP NQ NFC node is not on this board; the NFC chip is a PN547. */
	/delete-node/ nq@28;

	pn547@2b {
		compatible = "pn547";
		reg = <0x2b>;
		/* Only ven and pvdd sit behind the expander; irq and firm are on tlmm. */
		pn547,irq-gpio = <&tlmm 40 0x00>;
		pn547,ven-gpio = <&pcal6524 12 0x00>;
		pn547,firm-gpio = <&tlmm 80 0x00>;
		pn547,pvdd-gpio = <&pcal6524 7 0x00>;
		pn547,nfc_pm_clk;
		clocks = <&clock_rpmcc RPM_SMD_LN_BB_CLK3_PIN>;
		clock-names = "rf_clk";
	};
};

/*
 * ET5XX fingerprint sensor (etspi) on spi_3. DRDY is tlmm gpio13 and the
 * vendor pin is gpio12, sleep and LDO enables are pcal6524 pins 15 and 6,
 * as in stock r07.
 */
&tlmm {
	etspi_drdypin {
		etspi_drdypin_active: etspi_drdypin_active {
			mux {
				pins = "gpio13";
				function = "gpio";
			};

			config {
				pins = "gpio13";
				drive-strength = <2>;
				bias-disable;
			};
		};

		etspi_drdypin_suspend: etspi_drdypin_suspend {
			mux {
				pins = "gpio13";
				function = "gpio";
			};

			config {
				pins = "gpio13";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};

	etspi_vendorpin {
		etspi_vendorpin: etspi_vendorpin {
			mux {
				pins = "gpio12";
				function = "gpio";
			};

			config {
				pins = "gpio12";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};
};

&spi_3 {
	status = "okay";

	etspi-spi@0 {
		compatible = "etspi,et5xx";
		reg = <0x0>;
		spi-max-frequency = <16000000>;
		etspi-drdyPin = <&tlmm 13 0x1>;
		etspi-sleepPin = <&pcal6524 15 0x0>;
		etspi-ldoPin = <&pcal6524 6 0x0>;
		etspi-vendorPin = <&tlmm 12 0x0>;
		etspi-min_cpufreq_limit = <0x1ec300>;
		etspi-chipid = "ET510";
		pinctrl-names = "default", "sleep", "idle";
		pinctrl-0 = <&etspi_drdypin_suspend &etspi_vendorpin>;
		pinctrl-1 = <&etspi_drdypin_suspend>;
		pinctrl-2 = <&etspi_drdypin_active>;
	};
};

/*
 * Stock r07 nodes not yet ported (no driver or DT binding in this tree yet):
 * not yet: mdss_disp_det pinctrl (gpio 45/49), dfps_data_mem,
 * not yet: sm5705 (charger, fuel gauge, muic, fled, rgb),
 * not yet: s2mm005 usb-pd, sec_ts (second touch IC on i2c_4),
 * not yet: audio (dbmdx, sec_jack, q6audio),
 * not yet: camera flash, tdmb, battery/cable-info, thermistors,
 * not yet: usb-notifier, i2c-gpio buses 21/25/27, ss_plog, sec_debug/tima regions,
 * not yet: /chosen (stdout-path, bootargs), bt_wcn3990, input_booster.
 */
